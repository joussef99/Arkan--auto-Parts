{
  "name": "arkan-auto-parts-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main/index.cjs",
  "productName": "Arkan Auto Parts ERP",
  "author": "Arkan Auto Parts",
  "scripts": {
    "dev": "concurrently -k \"cross-env VITE_API_TARGET=http://127.0.0.1:5001 npm --prefix frontend start -- --host 127.0.0.1 --port 3001 --strictPort\" \"npm run electron:dev\"",
    "electron:dev": "wait-on tcp:3001 && cross-env ELECTRON_START_URL=http://127.0.0.1:3001 BACKEND_PORT=5001 electron .",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run build"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "bwip-js": "^4.10.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5",
    "electron-log": "^5.2.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "wait-on": "^8.0.5"
  }
}
